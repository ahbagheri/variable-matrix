{
  "manifestVersion": 1,
  "id": "variablematrix",
  "version": "1.0.1",
  "name": "Variable Matrix",
  "description": "View and manage Azure Pipelines Library variable groups across dev, QA, staging, and production in one matrix.",
  "publisher": "ahbagheri",
  "public": true,
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "variable groups",
    "pipelines",
    "library",
    "environments",
    "matrix",
    "configuration"
  ],
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "links": {
    "repository": {
      "uri": "https://github.com/ahbagheri/variable-matrix"
    },
    "issues": {
      "uri": "https://github.com/ahbagheri/variable-matrix/issues"
    },
    "support": {
      "uri": "https://github.com/ahbagheri/variable-matrix/issues"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/ahbagheri/variable-matrix"
  },
  "branding": {
    "color": "#0078d4",
    "theme": "dark"
  },
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scopes": [
    "vso.variablegroups_manage"
  ],
  "contributions": [
    {
      "id": "variable-matrix-hub",
      "type": "ms.vss-web.hub",
      "description": "Environment matrix for Azure Pipelines Library variable groups.",
      "targets": [
        "ms.vss-build-web.build-release-hub-group"
      ],
      "properties": {
        "name": "Variable Matrix",
        "order": 90,
        "uri": "dist/index.html"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "images",
      "addressable": true
    }
  ],
  "icons": {
    "default": "images/icon.png"
  }
}
